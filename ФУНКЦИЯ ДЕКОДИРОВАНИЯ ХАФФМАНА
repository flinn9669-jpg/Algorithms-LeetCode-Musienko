def huffman_decoding(encoded: str, codes: dict) -> str:
    if not encoded:
        return ""
    #переворачивает словарь: код - символ
    reverse_codes = {v: k for k, v in codes.items()}
    decoded = ""
    current_code = ""
    #идёт по битам
    for bit in encoded:
        current_code += bit  #накапливает   
        #если нашел код, то добавляет символ
        if current_code in reverse_codes:
            decoded += reverse_codes[current_code]
            current_code = ""  #сбрасывает
    return decoded
